[Variables]
; Edit values, then refresh the skin. No precise location is needed.
Scale=1
Opacity=240
; Background only: 0 = transparent, 255 = solid. Does not dim text or Moon.
BackgroundOpacity=200
; Rounded corner radius in base pixels; scales with Scale. 0 = square.
CornerRadius=20
Language=en
DateFormat=long
Hour24=1
Compact=0
ShowEvents=1
; Approximate latitude. 0 uses the northern convention; Santiago is about -33.
Latitude=0
; Data/alert polling seconds, clamped to 5-300. Phase image refresh: 5 minutes.
UpdateSeconds=30
; Notifications are visual messages INSIDE this widget; explicit opt-in only.
Notifications=0
NotifyAdvance=1
NotifyAtEvent=1
AdvanceHours=24
NotifyAllPhases=0
; Catch up reminders missed during sleep/restart within this many hours (0-48).
CatchUpHours=6
